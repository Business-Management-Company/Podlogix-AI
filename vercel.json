{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "dist/index.cjs"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "https://podlogix-landing.vercel.app/"
    },
    {
      "src": "/l/(.*)",
      "dest": "https://podlogix-landing.vercel.app/l/$1"
    },
    {
      "src": "/_next/(.*)",
      "dest": "https://podlogix-landing.vercel.app/_next/$1"
    },
    {
      "src": "/(icon\\.png|apple-icon\\.png|favicon\\.ico|opengraph-image\\.jpg)",
      "dest": "https://podlogix-landing.vercel.app/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/feeds/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/e/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/objects/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/enrich-creators",
      "schedule": "0 13 * * *"
    }
  ]
}
