# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Supabase Postgres.
# Local dev: use the Session pooler URI (port 5432).
# Vercel: use the Transaction pooler URI (port 6543) — better for serverless.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public URL used in generated RSS feed links (production domain).
# Leave unset in local dev — falls back to the request host.
# PUBLIC_BASE_URL=https://podlogix.io

# Supabase Storage (episode audio, artwork uploads).
# SUPABASE_URL: Project Settings -> General -> Project URL (https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API keys -> service_role. SERVER-ONLY SECRET.
# Bucket must exist and be PUBLIC (default name: media).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# Optional: real OpenAI key enables transcription, briefings, and AI chat.
# The app boots fine without these.
# OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional: enables social account analytics (Promotion tab, Audience "My Accounts").
# Get a key at https://influencers.club — calls are metered/credit-based.
# INFLUENCERS_CLUB_API_KEY=

# Local dev port (macOS AirPlay occupies 5000)
PORT=5001
