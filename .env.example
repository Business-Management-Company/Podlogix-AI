# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Supabase Postgres.
# Local dev: use the Session pooler URI (port 5432).
# Vercel: use the Transaction pooler URI (port 6543) — better for serverless.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public URL used in generated RSS feed links (production domain).
# Leave unset in local dev — falls back to the request host.
# PUBLIC_BASE_URL=https://podlogix.io

# Optional: real OpenAI key enables transcription, briefings, and AI chat.
# The app boots fine without these.
# OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=

# Local dev port (macOS AirPlay occupies 5000)
PORT=5001
